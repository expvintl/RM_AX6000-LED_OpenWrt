# 云编译前对齐检查用的包清单
# 语法：一行一个包名；行首加 ! 表示「关键包」，被 defconfig 吃掉就让编译直接失败
# 不带 ! 的只告警，不中断（版本差异导致的可选项）
#
# 注意：mwan3 会连带拉入 iptables(nft 变体) + ipset + 两个 iptables-mod-*，
#       所以这些不在列表里，但最终镜像里一定有。

!luci-theme-argon
luci-app-argon-config
!kmod-mt_wifi
kmod-warp
!kmod-mediatek_hnat
kmod-conninfra
kmod-nf-flow
!kmod-nft-tproxy
datconf
ucode-mod-datconf
l1util
ucode-mod-l1parser
kvcedit
libkvcutil
mii_mgr
regs
switch
wifi-dats
mtwifi-cfg-ucode
mtkhqos_util
!luci-app-mtwifi-cfg
luci-i18n-mtwifi-cfg-zh-cn
!luci-app-turboacc-mtk
luci-i18n-turboacc-mtk-zh-cn
luci-app-eqos-mtk
luci-i18n-eqos-mtk-zh-cn
!luci-app-openclash
# luci-app-openclash 没有独立 i18n 包（po/zh-cn 直接编进主包），不要写 luci-i18n-openclash-zh-cn
!luci-app-passwall
luci-i18n-passwall-zh-cn
luci-compat
!luci-app-adguardhome
!adguardhome
!luci-app-mwan3
luci-i18n-mwan3-zh-cn
!mwan3
luci-app-arpbind
luci-i18n-arpbind-zh-cn
luci-app-upnp
luci-i18n-upnp-zh-cn
# 25.12 把 miniupnpd 拆成 nftables / iptables 两个变体，默认变体的真实包名是 miniupnpd-nftables
miniupnpd-nftables
luci-app-vlmcsd
luci-i18n-vlmcsd-zh-cn
vlmcsd
!dnsmasq-full
6in4
umurmur-openssl
luci-app-mtk
bash
curl
ca-bundle
ca-certificates
unzip
wget-ssl
coreutils
coreutils-nohup
coreutils-base64
coreutils-timeout
libcap-bin
nano
htop
tcpdump
ethtool
zoneinfo-asia
block-mount
blockd
zram-swap
kmod-zram
openssh-keygen
openssh-sftp-server
openssl-util
resolveip
iw
iwinfo-ucode
tc-tiny
wireless-regdb
wireless-tools
ip-bridge
!kmod-tun
!kmod-wireguard
kmod-macvlan
kmod-ifb
kmod-inet-diag
kmod-nft-socket
kmod-nft-compat
# 源码目录叫 fullconenat-nft，但 KernelPackage 定义的是 nft-fullcone，真包名是 kmod-nft-fullcone
!kmod-nft-fullcone
kmod-nf-nathelper-extra
kmod-sched-core
kmod-sched-cake
kmod-tcp-bbr
kmod-fs-vfat
kmod-fs-autofs4
kmod-nls-base
kmod-nls-cp437
kmod-nls-iso8859-1
kmod-nls-utf8
kmod-ata-core
kmod-scsi-core
kmod-crypto-acompress
