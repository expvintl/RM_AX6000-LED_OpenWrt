## ======================================================================
## 软件包清单 —— 已按老固件的 opkg-installed.txt 对齐（2026-10 备份）
## 说明：25.12 是 nftables 时代，openclash / passwall 新版都已改成 nft 后端，
##       老固件里那一大堆 iptables-mod-* / kmod-ipt-* / ipset 不再需要。
## ======================================================================

## ---- 代理 / 分流 ----
CONFIG_PACKAGE_luci-app-openclash=y
## OpenClash 没有独立的 i18n 包：它的 Makefile 不走 luci.mk，
## 而是用 po2lmo 把 po/zh-cn 直接编进主包，所以 luci-i18n-openclash-zh-cn 不存在
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
## openclash / passwall 都依赖它（老固件里也装了）
CONFIG_PACKAGE_luci-compat=y

## ---- 网络服务 ----
## 去广告
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y
## 多拨 / 负载均衡
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
CONFIG_PACKAGE_mwan3=y
## 静态 IP 绑定
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-i18n-arpbind-zh-cn=y
## UPnP
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
## 25.12 的 miniupnpd 拆成 nftables / iptables 两个变体，
## 默认变体（DEFAULT_VARIANT）的真实包名是 miniupnpd-nftables；miniupnpd 只是 PROVIDES 出来的虚名
CONFIG_PACKAGE_miniupnpd-nftables=y
## KMS 服务器
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_vlmcsd=y
## DNS / IPv6 隧道 / Mumble 语音
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_umurmur-openssl=y
## MTK 专属面板（老固件里的 luci-app-mtk）
CONFIG_PACKAGE_luci-app-mtk=y

## ---- 系统 / 工具 ----
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-timeout=y
## libcap-bin 的 DEPENDS 写的是不带 + 的 libcap（只依赖、不选中），
## 不手动打开 libcap 的话它会被 defconfig 当成依赖不满足直接丢掉
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcap-bin=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_openssh-keygen=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo-ucode=y
CONFIG_PACKAGE_tc-tiny=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_wireless-tools=y
CONFIG_PACKAGE_ip-bridge=y

## ---- 内核模块：老固件真在用、25.12 里依然有的（重点对齐区）----
## 代理 / 隧道底座：你上次踩坑的就是这一类
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-compat=y
## 全锥 NAT（nft 版，替代老的 iptables-mod-fullconenat）
## 坑：源码目录叫 package/network/utils/fullconenat-nft，但 Makefile 里是
##     $(eval $(call KernelPackage,nft-fullcone))，所以真包名是 kmod-nft-fullcone；
##     写 fullconenat-nft 会被 defconfig 静默丢弃（firewall4 也直接依赖 kmod-nft-fullcone）
CONFIG_PACKAGE_kmod-nft-fullcone=y
## 网络辅助：PPTP/L2TP/PPPoE 穿透等
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y
## 队列 / 限速
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-cake=y
## TCP BBR
CONFIG_PACKAGE_kmod-tcp-bbr=y
## 存储 / 文件系统
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-autofs4=y
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-ata-core=y
CONFIG_PACKAGE_kmod-scsi-core=y
## 网桥过滤：老固件其实没装 ebtables，这里也不装（nft bridge 家族可替代）
## 加密（WireGuard / OpenVPN 依赖链）
CONFIG_PACKAGE_kmod-crypto-acompress=y
CONFIG_PACKAGE_kmod-crypto-ccm=y
CONFIG_PACKAGE_kmod-crypto-cmac=y
CONFIG_PACKAGE_kmod-crypto-crc32c=y
CONFIG_PACKAGE_kmod-crypto-ctr=y
CONFIG_PACKAGE_kmod-crypto-des=y
CONFIG_PACKAGE_kmod-crypto-gcm=y
CONFIG_PACKAGE_kmod-crypto-gf128=y
CONFIG_PACKAGE_kmod-crypto-ghash=y
CONFIG_PACKAGE_kmod-crypto-hmac=y
CONFIG_PACKAGE_kmod-crypto-md4=y
CONFIG_PACKAGE_kmod-crypto-md5=y
CONFIG_PACKAGE_kmod-crypto-rng=y
CONFIG_PACKAGE_kmod-crypto-seqiv=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-crypto-sha512=y
CONFIG_PACKAGE_kmod-lib-crc32c=y
CONFIG_PACKAGE_kmod-lib-lzo=y
## AX6000 的 RGB 灯珠（ws2812b），走 SPI，删掉不影响功能
CONFIG_PACKAGE_kmod-leds-ws2812b=y

## ---- 兼容层：默认关闭（要老脚本行为再打开）----
## 说明：25.12 的 `iptables` 命令是存在的，而且会被 mwan3 自动拉进来
##      （mwan3 2.12.0 DEPENDS: +iptables +ipset +iptables-mod-conntrack-extra +iptables-mod-ipopt）。
##      默认变体是 iptables-nft：命令照用，规则会被翻译成 nftables。
##      下面这些是 21.02 时代的 legacy 后端，只有确实要跑老插件时才打开，
##      打开后 legacy 表和 firewall4 的 nft 表互不可见，可能双份 NAT，慎用。
# CONFIG_PACKAGE_iptables-zz-legacy=y
# CONFIG_PACKAGE_ip6tables-zz-legacy=y
# CONFIG_PACKAGE_kmod-ipt-extra=y
# CONFIG_PACKAGE_kmod-ipt-filter=y
# CONFIG_PACKAGE_kmod-ipt-hashlimit=y
# CONFIG_PACKAGE_kmod-ipt-iface=y
# CONFIG_PACKAGE_kmod-ipt-ipmark=y
# CONFIG_PACKAGE_kmod-ipt-iprange=y
# CONFIG_PACKAGE_kmod-ipt-ipv4options=y
# CONFIG_PACKAGE_kmod-ipt-nat-extra=y
# CONFIG_PACKAGE_kmod-ipt-proto=y
# CONFIG_PACKAGE_kmod-ipt-raw=y
# CONFIG_PACKAGE_kmod-ipt-raw6=y
# CONFIG_PACKAGE_kmod-ipt-tee=y
# CONFIG_PACKAGE_kmod-ipt-u32=y

## ---- 代码里已经没有、或已被取代的（保留说明，别再加回来）----
##  iptables / ip6tables / iptables-mod-* / kmod-ipt-*  → 25.12 由 mwan3 自动拉入 nft 变体，无需手写
##  ipset / kmod-ipt-ipset                              → 用 nft set，插件已不只吃 ipset
##  kmod-ipt-fullconenat                                → 换成 kmod-nft-fullcone（上面已加）
##  kmod-mtd-rw                                         → 25.12 源码树里没有这个包，别写，否则被静默丢弃
##  ipv6helper                                          → 25.12 已无此包（能力并入 base）
##  luci-app-filetransfer                               → LuCI 已移除该插件
##  luci-app-easytier / easytier                        → 官方源没有，需第三方 feed 或 opkg 装 ipk
##  datconf-lua / luci-app-turboacc（旧版）              → 已改名为 datconf / luci-app-turboacc-mtk
##  mhz / shellsync / kvcedit / regs                    → MTK 工具，前三个在闭源驱动那一段已含/已废
## ------------通用编译选项 START------------
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_INCLUDE_CONFIG=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
CONFIG_AFALG_UPDATE_CTR_IV=y
# CONFIG_AFALG_FALLBACK is not set
CONFIG_BUSYBOX_CONFIG_BLKID=y
CONFIG_BUSYBOX_CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_BUSYBOX_CONFIG_VOLUMEID=y
# CONFIG_GDB is not set
# CONFIG_KERNEL_BLK_DEV_THROTTLING is not set
# CONFIG_KERNEL_CFS_BANDWIDTH is not set
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_DEVMEM=y
# CONFIG_KERNEL_KEYS is not set
# CONFIG_KERNEL_MEMCG_SWAP is not set
CONFIG_KERNEL_NET_CLS_CGROUP=y
CONFIG_OPENSSL_WITH_NPN=y
# CONFIG_OPENSSL_ENGINE_BUILTIN is not set
# CONFIG_OPENSSL_PREFER_CHACHA_OVER_GCM is not set
CONFIG_PKG_FORTIFY_SOURCE_2=y
# CONFIG_PKG_CHECK_FORMAT_SECURITY is not set
# CONFIG_WOLFSSL_HAS_ECC25519 is not set
## TURBOACC_INCLUDE_* 是 luci-app-turboacc（旧版）的配置项，mtk 版 luci-app-turboacc-mtk
## 的 Makefile 里没有 config 段，这两个符号在 25.12 不存在，写了也会被 defconfig 吃掉。
## HNAT / 全锥的开关直接在 LuCI 的 TurboACC 页面里点，不靠预置 config 符号。
# CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING is not set
# CONFIG_PACKAGE_TURBOACC_INCLUDE_NO_FASTPATH is not set
## ------------通用编译选项 END--------------
